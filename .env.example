# Environment Configuration for Pneumonia Detection System

# Application Environment
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Data Configuration
DATA_DIR=data
BATCH_SIZE=32
IMAGE_SIZE=224
AUGMENTATION_ENABLED=true

# Model Configuration
MODEL_TYPE=resnet50
LEARNING_RATE=0.001
EPOCHS=50
DROPOUT_RATE=0.5

# Inference Configuration
MODEL_PATH=models/pneumonia_detector.h5
CONFIDENCE_THRESHOLD=0.5
ENABLE_GRAD_CAM=true

# UI Configuration
UI_HOST=0.0.0.0
UI_PORT=8000
UI_DEBUG=false
MAX_UPLOAD_SIZE=10485760

# Database Configuration (if using)
# DATABASE_URL=sqlite:///pneumonia_detection.db

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
